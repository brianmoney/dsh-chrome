{
  "manifest_version": 3,
  "name": "dsh-chrome",
  "version": "0.1.2",
  "key": "",
  "description": "DeepSeek Harness (dsh) browser companion: embeds the full dsh web UI in a side panel and lets the dsh agent read the current page, capture HTTP traffic, and drive the browser.",
  "minimum_chrome_version": "118",
  "permissions": [
    "sidePanel",
    "scripting",
    "tabs",
    "activeTab",
    "storage",
    "debugger",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "options_ui": {
    "page": "src/options.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open dsh-chrome",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
